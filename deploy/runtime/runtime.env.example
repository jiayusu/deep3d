# Copy outside the repository or to an ignored .env file and fill locally.
# Use URL-safe random values; keep operator and worker tokens distinct.
POSTGRES_PASSWORD=replace_with_random_url_safe_database_password
DEEP3D_OPERATOR_TOKEN=replace_with_random_operator_token_at_least_24_characters
DEEP3D_WORKER_TOKEN=replace_with_random_worker_token_at_least_24_characters
